# Credenciales de Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clave de API de Google Gemini (Gratuita) para resúmenes de libros y biografías narrativas
GEMINI_API_KEY=tu_clave_gemini_api_aqui

# Proveedor de IA a utilizar ("gemini" o "local")
LLM_PROVIDER=gemini

# Configuración de IA Local (Ollama, LM Studio o API compatible con OpenAI)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=600
